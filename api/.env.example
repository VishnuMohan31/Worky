# Application Configuration
APP_NAME=Worky API
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5437
DATABASE_NAME=worky
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Security Configuration
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
CORS_ORIGINS=["http://localhost:3007", "http://localhost:3000", "http://localhost:8007"]

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=/app/logs/worky-api.log

# External Services
GITHUB_TOKEN=
GITLAB_TOKEN=
BITBUCKET_TOKEN=
DISCORD_WEBHOOK_URL=

# LLM / Chat AI (Required for AI chat responses)
# Variable name MUST be LLM_API_KEY (not OPENAI_API_KEY)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1000
LLM_TIMEOUT=30

# Redis (used by chat sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1

# Monitoring
PROMETHEUS_PORT=9090
LOKI_URL=
