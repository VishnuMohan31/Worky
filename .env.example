# Worky Environment Configuration
# Copy this file to .env and update with your values
#
# For LOCAL development: Use localhost
# For PRODUCTION: Use your server IP or domain

# ===========================================
# Shared Data Path (REQUIRED)
# All persistent data stored here - survives docker compose down -v
#
# IMPORTANT RULES:
#   1. Must be an ABSOLUTE path (relative paths like ../foo do NOT work with
#      Docker Desktop on Windows and will cause volume mounts to silently fail)
#   2. Use forward slashes even on Windows: D:/MyData/Worky_Shared_Data
#   3. Docker Desktop on Windows does NOT auto-create host-side directories.
#      The directory is created automatically on first `docker compose up`
#      via the init-dirs service defined in docker-compose.yml.
#
# Windows example:
#   SHARED_DATA_PATH=D:/DL_Space/Worky_Shared_Data
# Linux/Mac example:
#   SHARED_DATA_PATH=/opt/worky/shared_data
# ===========================================
SHARED_DATA_PATH=D:/DL_Space/Worky_Shared_Data

# ===========================================
# UI Configuration (REQUIRED)
# ===========================================
# For local development:
VITE_API_BASE_URL=http://localhost:8007/api/v1

# For production server, replace with your server IP:
# VITE_API_BASE_URL=http://YOUR_SERVER_IP:8007/api/v1
# Example: VITE_API_BASE_URL=http://62.171.191.132:8007/api/v1

# ===========================================
# Database Configuration (Optional)
# ===========================================
# Defaults are set in docker-compose.yml
# Only uncomment if you need to change them
# POSTGRES_DB=worky
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# ===========================================
# API Security (Optional)
# ===========================================
# Generate a secure secret key for production
# SECRET_KEY=your-secret-key-change-in-production

# ===========================================
# External Services (Optional)
# ===========================================
# GITHUB_TOKEN=
# GITLAB_TOKEN=
# BITBUCKET_TOKEN=
# DISCORD_WEBHOOK_URL=
