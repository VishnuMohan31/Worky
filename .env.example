# Environment Variables for Docker Compose
# Copy this file to .env and update with your values

# For LOCAL development, leave this commented or set to localhost
# VITE_API_BASE_URL=http://localhost:8007/api/v1

# For PRODUCTION/REMOTE server, uncomment and set your server IP/domain
# VITE_API_BASE_URL=http://62.171.191.132:8007/api/v1

# Database credentials (optional, defaults are set in docker-compose.yml)
# POSTGRES_PASSWORD=your_secure_password

# API Security (optional)
# SECRET_KEY=your-secret-key-change-in-production
