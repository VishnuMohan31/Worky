# Worky Environment Configuration
# Copy this file to .env and update with your values
# 
# For LOCAL development: Use localhost
# For PRODUCTION: Use your server IP or domain

# ===========================================
# Shared Data Path (auto-created on first run)
# All persistent data stored here - survives docker compose down -v
# ===========================================
SHARED_DATA_PATH=../Worky_Shared_Data

# ===========================================
# UI Configuration (REQUIRED)
# ===========================================
# For local development:
VITE_API_BASE_URL=http://localhost:8007/api/v1

# For production server, replace with your server IP:
# VITE_API_BASE_URL=http://YOUR_SERVER_IP:8007/api/v1
# Example: VITE_API_BASE_URL=http://62.171.191.132:8007/api/v1

# ===========================================
# Database Configuration (Optional)
# ===========================================
# Defaults are set in docker-compose.yml
# Only uncomment if you need to change them
# POSTGRES_DB=worky
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# ===========================================
# API Security (Optional)
# ===========================================
# Generate a secure secret key for production
# SECRET_KEY=your-secret-key-change-in-production

# ===========================================
# External Services (Optional)
# ===========================================
# GITHUB_TOKEN=
# GITLAB_TOKEN=
# BITBUCKET_TOKEN=
# DISCORD_WEBHOOK_URL=

# ===========================================
# LLM / Chat AI (Required for AI chat responses)
# ===========================================
# Variable name MUST be LLM_API_KEY (not OPENAI_API_KEY)
# After changing these, recreate the API container:
#   docker compose up -d --force-recreate api
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=1000
# LLM_TIMEOUT=30
